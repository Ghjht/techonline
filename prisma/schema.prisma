generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  subcategory String?
  brand       String
  description String
  features    String[]
  specs       Json
  price       Float
  image       String
  images      String[]
  stock       Int      @default(0)
  rating      Float    @default(0)
  reviews     Int      @default(0)
  isNew       Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
